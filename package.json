{
  "name": "stock-uploader",
  "productName": "Stock Uploader",
  "version": "1.7.0",
  "description": "Uploader FTP/FTPS/SFTP pribadi untuk banyak akun microstock",
  "private": true,
  "main": "./out/main/index.js",
  "author": "hadyanbaqi",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:conn": "node scripts/test-connection.mts",
    "test:upload": "node scripts/test-upload.mts",
    "test:meta": "node scripts/test-metadata.mts",
    "test:csv": "node scripts/test-csvtools.mts",
    "test:gen": "node scripts/test-imagegen.mts",
    "test:alpha": "node scripts/test-alpha.mts",
    "test:profiles": "node scripts/test-profiles.mts",
    "test:psd": "node scripts/test-psd.mts",
    "test:update": "node scripts/test-update.mts",
    "test:upscale": "node scripts/test-upscale.mts",
    "upscaler": "node scripts/fetch-upscaler.mts",
    "ci:test": "npm run typecheck && npm run test:conn && npm run test:upload && npm run test:meta && npm run test:csv && npm run test:gen && npm run test:alpha && npm run test:profiles && npm run test:psd && npm run test:update && npm run test:upscale",
    "test:app": "electron-vite build && node scripts/test-app.mts",
    "dist:win": "node scripts/fetch-upscaler.mts win32 && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "node scripts/fetch-upscaler.mts darwin && electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "exiftool-vendored": "^39.2.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "ftp-srv": "^4.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
